DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=soruhavuzu.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://soruhavuzu.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_COLLECTSTATIC=true

API_ANON_THROTTLE_RATE=60/min
API_USER_THROTTLE_RATE=600/min

POSTGRES_DB=soru_havuzu
POSTGRES_USER=soru_havuzu
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

APP_DOMAIN=soruhavuzu.example.com

# Yerel medya hacmi yerine S3 uyumlu nesne depolaması kullanılacaksa açın.
DJANGO_USE_S3=false
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=
S3_ENDPOINT_URL=
